{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext", "webworker"],
    "jsx": "preserve",
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.web.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "@streamwise/core": ["../../packages/core/src/index.ts"],
      "@streamwise/server": ["../../packages/server/src/index.ts"],
      "@streamwise/server/routes/*": ["../../packages/server/src/routes/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
