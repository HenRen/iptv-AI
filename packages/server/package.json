{
  "name": "@streamwise/server",
  "version": "0.1.0",
  "private": true,
  "description": "StreamWise API: route handlers, SSRF guard, rate limiter and the Node bindings for @streamwise/core. Deployable on its own.",
  "sideEffects": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./routes/*": "./src/routes/*.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "esbuild src/standalone.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/standalone.cjs",
    "start": "node dist/standalone.cjs"
  },
  "dependencies": {
    "@streamwise/core": "*"
  }
}
