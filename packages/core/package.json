{
  "name": "@streamwise/core",
  "version": "0.1.0",
  "private": true,
  "description": "Platform-agnostic StreamWise core: IPTV adapters, catalogue, EPG matching, AI services, design tokens. No DOM, no platform APIs.",
  "sideEffects": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ports": "./src/ports/index.ts",
    "./design": "./src/design/index.ts",
    "./testing": "./src/testing/index.ts",
    "./client": "./src/client/ApiClient.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  }
}
