# Encrypts stored IPTV credentials at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32
# Required in production; a fixed development key is used when unset.
HENREN_SECRET=

# Where playlists, catalog snapshots and EPG snapshots are written.
# Defaults to ./.data
HENREN_DATA_DIR=

# Allow the proxy to reach private/loopback addresses.
# Only enable this if your IPTV provider genuinely runs on your LAN.
# HENREN_ALLOW_PRIVATE_HOSTS=false

# Some providers reject non-player user agents on stream requests.
# HENREN_STREAM_USER_AGENT=VLC/3.0.20 LibVLC/3.0.20

# Optional. Absent = the built-in rules provider, which is fully functional.
# Credentials are never sent to an AI provider.
OPENAI_API_KEY=
